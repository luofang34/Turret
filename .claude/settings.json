{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-fmt.sh",
            "timeout": 10,
            "statusMessage": "checking cargo fmt before git commit"
          }
        ]
      }
    ]
  }
}
